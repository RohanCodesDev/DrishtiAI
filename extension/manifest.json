{
  "manifest_version": 3,
  "name": "DrishtiAI",
  "version": "1.0",
  "description": "Privacy-first Browser Agent",
  "action": {
    "default_title": "Open DrishtiAI Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}