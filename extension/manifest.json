{
  "manifest_version": 3,
  "name": "DrishtiAI",
  "version": "1.0",
  "description": "Privacy-first Browser Agent",
  "action": {
    "default_title": "Open DrishtiAI Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}